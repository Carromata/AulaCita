# Copie este archivo a .env y complete solo valores propios del entorno.
# Nunca use sa ni una cuenta db_owner para la aplicación.
DB_URL=jdbc:sqlserver://localhost;instanceName=SQLEXPRESS;databaseName=AulaCitaDB_Real;encrypt=true;trustServerCertificate=true;loginTimeout=5
DB_USER=aulacita_app
DB_PASSWORD=
DB_MIGRATION_USER=aulacita_migrator
DB_MIGRATION_PASSWORD=
DB_POOL_SIZE=10
DB_MIGRATIONS_ENABLED=true
SERVER_PORT=8080
SESSION_COOKIE_SECURE=false

# SMTP para recuperación de contraseña. Dejar vacío mantiene esa función
# deshabilitada explícitamente. En producción, guardar los valores como secretos.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
AULACITA_PUBLIC_URL=http://localhost:8080
PASSWORD_RESET_EXPIRATION_MINUTES=30

# Solo para Docker Compose de desarrollo:
DB_URL_DOCKER=jdbc:sqlserver://sqlserver:1433;databaseName=AulaCitaDB_Real;encrypt=true;trustServerCertificate=true;loginTimeout=5
MSSQL_SA_PASSWORD=

# Use credenciales fuertes y locales solo para el SQL Server de desarrollo.
# En producción, use TLS válido y SESSION_COOKIE_SECURE=true.
